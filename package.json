{
  "name": "apphelm",
  "version": "0.1.0",
  "description": "MCP를 지원하지 않는 Windows 프로그램을 AI가 조작할 수 있도록 조작 문서를 만드는 도구",
  "type": "module",
  "license": "MIT",
  "bin": {
    "apphelm": "bin/apphelm.mjs",
    "apphelm-mcp": "bin/apphelm-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "agent",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "map": "tsx src/cli/main.ts map",
    "mcp": "tsx src/mcp/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "e2e": "node --import tsx --test \"test/e2e/**/*.test.ts\"",
    "check:boundaries": "tsx scripts/check-boundaries.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
